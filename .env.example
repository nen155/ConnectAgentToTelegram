# --- Telegram ---
# Token que te da @BotFather al crear el bot (obligatorio).
TELEGRAM_BOT_TOKEN=

# Tu id numerico de usuario de Telegram, separado por comas si sois varios.
# Solo estos usuarios pueden dar ordenes. Si lo dejas vacio, el bot no ejecuta nada:
# se limita a responderte con tu user id para que lo pegues aqui.
TELEGRAM_ALLOWED_USER_IDS=

# --- Devin CLI ---
# Ruta al ejecutable. Por defecto se detecta en %LOCALAPPDATA%\devin\cli\bin\devin.exe
# DEVIN_BIN=C:\Users\tu-usuario\AppData\Local\devin\cli\bin\devin.exe

# Carpeta donde trabaja Devin (por defecto, la raiz de este proyecto).
# DEVIN_WORKDIR=C:\ruta\a\tu-proyecto

# normal | accept-edits | smart | dangerous
# OJO: "dangerous" (yolo) ejecuta cualquier comando sin preguntar.
DEVIN_PERMISSION_MODE=dangerous

# Modelo opcional (alias o nombre). Ej: opus, sonnet
# DEVIN_MODEL=

# Tiempo maximo por orden, en milisegundos (20 min por defecto).
DEVIN_TIMEOUT_MS=1200000

# auto    -> reanuda la sesion guardada y, si no hay id, usa --continue
# new     -> cada orden abre una sesion limpia (sin memoria)
# continue-> siempre --continue (una sola sesion por carpeta)
DEVIN_CONTINUITY=auto

# auto -> si el proyecto esta abierto en Devin Desktop, la orden continua esa sesion
#         (mismo historial). El turno se ejecuta en el CLI, no en la ventana.
# chat -> cada chat de Telegram tiene su propia sesion, sin tocar las del IDE.
DEVIN_ROUTE=auto

# Argumentos extra para el CLI, separados por espacios.
# DEVIN_EXTRA_ARGS=

# --- Whisper local ---
# Rutas por defecto: vendor\whisper\whisper-cli.exe y vendor\models\ggml-small.bin
# WHISPER_BIN=
# WHISPER_MODEL=
WHISPER_LANG=es
WHISPER_THREADS=4
WHISPER_TIMEOUT_MS=300000

# --- Voz de vuelta (TTS de Windows) ---
TTS_ENABLED=true
# Nombre parcial o cultura de la voz instalada. Ej: es-ES, es-MX
# TTS_VOICE=es-ES
# Velocidad: -10 (lento) a 10 (rapido)
TTS_RATE=0
# Recorta el audio de respuesta a esta longitud de texto.
TTS_MAX_CHARS=1200

# --- Varios ---
FFMPEG_BIN=ffmpeg
LOG_LEVEL=info
# DATA_DIR=.\data

# Modo demostracion: sustituye la transcripcion y las respuestas de Devin por mocks.
# Sirve para probar el bot, la cola, el TTS y la bandeja sin cuenta de Devin ni whisper.
MOCK_MODE=false
