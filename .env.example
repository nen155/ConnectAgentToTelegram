# --- Telegram ---
# Token que te da @BotFather al crear el bot (obligatorio).
TELEGRAM_BOT_TOKEN=

# Tu id numerico de usuario de Telegram, separado por comas si sois varios.
# Solo estos usuarios pueden dar ordenes. Si lo dejas vacio, el bot no ejecuta nada:
# se limita a responderte con tu user id para que lo pegues aqui.
TELEGRAM_ALLOWED_USER_IDS=

# --- Agente ---
# devin | opencode | codex | claude | openai
# Cada agente tiene su bloque de ajustes mas abajo; solo se leen los del elegido.
AGENT=devin

# Carpeta donde trabaja el agente (por defecto, la raiz de este proyecto).
# AGENT_WORKDIR=C:\ruta\a\tu-proyecto

# Tiempo maximo por orden, en milisegundos (20 min por defecto).
# AGENT_TIMEOUT_MS=1200000

# auto     -> reanuda la sesion guardada y, si no hay id, continua la ultima
# new      -> cada orden abre una sesion limpia (sin memoria)
# continue -> siempre continua la ultima sesion de la carpeta
# AGENT_CONTINUITY=auto

# auto    -> si el proyecto esta abierto en el IDE del agente, la orden continua esa sesion
# desktop -> escribe la orden en la UI del agente: la ventana de Devin Desktop o la
#            terminal integrada del IDE (OpenCode, Codex, Claude Code)
# chat    -> cada chat de Telegram tiene su propia sesion, sin tocar las del IDE
# AGENT_ROUTE=auto

# Sufijo del titulo de las ventanas del IDE ("<proyecto> - Devin").
# IDE_WINDOW_SUFFIX=" - Devin"

# --- Devin CLI ---
# Ruta al ejecutable. Por defecto se detecta en %LOCALAPPDATA%\devin\cli\bin\devin.exe
# DEVIN_BIN=C:\Users\tu-usuario\AppData\Local\devin\cli\bin\devin.exe
# normal | accept-edits | smart | dangerous
# OJO: "dangerous" (yolo) ejecuta cualquier comando sin preguntar.
DEVIN_PERMISSION_MODE=dangerous
# DEVIN_MODEL=
# DEVIN_EXTRA_ARGS=
# Base de sesiones (IDE + CLI) para el panel y los avisos.
# DEVIN_SESSIONS_DB=%APPDATA%\devin\cli\sessions.db

# --- OpenCode ---
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=opencode/big-pickle
# OPENCODE_AGENT=build
# OJO: sin confirmaciones (--dangerously-skip-permissions).
OPENCODE_SKIP_PERMISSIONS=true
# OPENCODE_EXTRA_ARGS=
# OPENCODE_SESSIONS_DB=%USERPROFILE%\.local\share\opencode\opencode.db
# Texto que debe identificar la terminal del agente antes de escribir en ella.
OPENCODE_TERMINAL_PATTERN=opencode

# --- Codex (CLI de OpenAI) ---
# CODEX_BIN=codex
# CODEX_MODEL=gpt-5-codex
# OJO: --full-auto ejecuta sin pedir aprobacion.
CODEX_FULL_AUTO=true
CODEX_SKIP_GIT_CHECK=true
# CODEX_EXTRA_ARGS=
# CODEX_SESSIONS_DIR=%USERPROFILE%\.codex\sessions
CODEX_TERMINAL_PATTERN=codex

# --- Claude Code ---
# CLAUDE_BIN=claude
# CLAUDE_MODEL=claude-sonnet-4-6
# default | acceptEdits | plan | dontAsk | bypassPermissions
# OJO: bypassPermissions ejecuta sin pedir aprobacion.
CLAUDE_PERMISSION_MODE=bypassPermissions
# CLAUDE_EXTRA_ARGS=
# CLAUDE_PROJECTS_DIR=%USERPROFILE%\.claude\projects
CLAUDE_TERMINAL_PATTERN=claude

# --- OpenAI API (sin CLI ni acceso al repositorio) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=
# OPENAI_TEMPERATURE=
# OPENAI_SYSTEM_PROMPT=

# --- Whisper local ---
# Rutas por defecto: vendor\whisper\whisper-cli.exe y vendor\models\ggml-small.bin
# WHISPER_BIN=
# WHISPER_MODEL=
WHISPER_LANG=es
WHISPER_THREADS=4
WHISPER_TIMEOUT_MS=300000

# --- Voz de vuelta (TTS de Windows) ---
TTS_ENABLED=true
# Nombre parcial o cultura de la voz instalada. Ej: es-ES, es-MX
# TTS_VOICE=es-ES
# Velocidad: -10 (lento) a 10 (rapido)
TTS_RATE=0
# Recorta el audio de respuesta a esta longitud de texto.
TTS_MAX_CHARS=1200

# --- Varios ---
FFMPEG_BIN=ffmpeg
LOG_LEVEL=info
# DATA_DIR=.\data
# Idioma en el que se pide el resumen al agente: es | en | (vacio, no forzar)
SUMMARY_LANGUAGE=es

# Modo demostracion: sustituye la transcripcion y las respuestas del agente por mocks.
# Sirve para probar el bot, la cola, el TTS y la bandeja sin cuenta de ningun agente.
MOCK_MODE=false
